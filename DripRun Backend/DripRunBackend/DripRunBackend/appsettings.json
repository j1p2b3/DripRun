{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "<FromEnvironment>"
  },

  "BlobStorage": {
    "ConnectionString": "<FromEnvironment>",
    "ContainerName": "modelsimages-coupimages",
    "SecureContainerName": "haulcoup-secureimages"
  },

  "Google": {
    "ClientId": "<FromEnvironment>"
  },

  "Facebook": {
    "AppId": "<FromEnvironment>",
    "AppSecret": "<FromEnvironment>"
  },

  "Apple": {
    "ClientId": "<FromEnvironment>",
    "BundleId": "<FromEnvironment>",
    "AdminWebClientId": "<FromEnvironment>",
    "WebClientId": "<FromEnvironment>"
  },

  "JWT_SECRET": "<FromEnvironment>",
  "JWT_ISSUER": "DripRunBackend",
  "JWT_AUDIENCE": "DripRunUsers",
  "JWT_ADMIN_AUDIENCE": "DripRunAdmin",

  "Refresh": {
    "Pepper": "<FromEnvironment>",
    "Days": "60"
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/*",
        "Period": "10m",
        "Limit": 60
      },
      {
        "Endpoint": "*:/api/admin-auth/*",
        "Period": "10m",
        "Limit": 60
      },
      {
        "Endpoint": "POST:/api/points/login",
        "Period": "12h",
        "Limit": 1
      },
      {
        "Endpoint": "POST:/api/brandrequests",
        "Period": "1d",
        "Limit": 1
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 3600
      }
    ]
  }
}
